# ==============================================================================
# Goose Mattermost Bridge Configuration
# ==============================================================================
# Copy this file to '.env' and fill in the required values.
# Ensure that all keys, values, formats, and comments are updated appropriately.

# ------------------------------------------------------------------------------
# Mattermost Connectivity
# ------------------------------------------------------------------------------

# The domain or IP address of your Mattermost server.
# Format: Host name only (do not include protocol/scheme, port, or trailing slash).
# Example: mattermost.example.com
MATTERMOST_URL=mattermost.example.com

# Mattermost Personal Access Token or Bot Token.
# Format: Cryptographic token string.
# Example: xx11yy22zz33...
MATTERMOST_TOKEN=your_mattermost_token_here

# Connection scheme to Mattermost.
# Format: http or https (recommended)
# Default: https
MATTERMOST_SCHEME=https

# Connection port to Mattermost.
# Format: Integer port number.
# Default: 443
MATTERMOST_PORT=443

# ------------------------------------------------------------------------------
# Bridge Settings & Access Control
# ------------------------------------------------------------------------------

# Comma-separated list of Mattermost usernames authorized to interact with Goose.
# Format: comma-separated list of strings without spaces.
# Example: alice,bob,charlie
APPROVED_USERS=alice,bob

# How often (in seconds) the bridge polls Mattermost for new messages.
# Format: Positive integer.
# Default: 1
POLL_INTERVAL=1

# Maximum number of concurrent active conversational sessions.
# Format: Positive integer.
# Default: 100
MAX_SESSIONS=100

# Path to the JSON file containing user-to-system-user mapping configuration.
# Format: File path relative to repository root or absolute path.
# Default: user_mapping.json
USER_MAPPING_FILE=user_mapping.json

# If set to true, only users explicitly defined in USER_MAPPING_FILE can use the bridge.
# If false, any user in APPROVED_USERS can interact, falling back to a default system user if not mapped.
# Format: true or false
# Default: false
REQUIRE_USER_MAPPING=false

# ------------------------------------------------------------------------------
# Logging & User Experience / Interface
# ------------------------------------------------------------------------------

# Enable verbose debug logs on stdout.
# Format: true or false
# Default: false
DEBUG=false

# Show Goose's complete step-by-step thinking trace inside Mattermost replies.
# Format: true or false
# Default: true
GOOSE_THINKING_TRACE=true

# Show the thinking trace in a simplified/collapsed format (using a Details/Summary HTML tag).
# Format: true or false
# Default: true
GOOSE_THINKING_TRACE_SIMPLIFIED=true

# ------------------------------------------------------------------------------
# Goose Process & Remote Procedure Call (RPC)
# ------------------------------------------------------------------------------

# Timeout in seconds for conversational RPC calls to the Goose subprocess.
# Format: Positive integer.
# Default: 600
RPC_TIMEOUT=600

# ------------------------------------------------------------------------------
# Model Context Protocol (MCP) Server Settings (for the bridge itself)
# ------------------------------------------------------------------------------

# Whether the built-in MCP server of the bridge is enabled.
# Format: true or false
# Default: true
MCP_ENABLED=true

# Host address the bridge's internal MCP server should listen on.
# Format: IP address or hostname.
# Default: 127.0.0.1
MCP_HOST=127.0.0.1

# Port number for the bridge's internal MCP server.
# Format: Integer port number.
# Default: 8000
MCP_PORT=8000

# ------------------------------------------------------------------------------
# Goose AI Provider & Model Configuration
# ------------------------------------------------------------------------------
# These env vars configure the LLM provider and API keys used by the Goose binary.
# Note: These values override any system-wide or global Goose configuration files.

# The LLM provider for Goose.
# Options: openai, anthropic, google, mistral
# Example: anthropic
GOOSE_PROVIDER=anthropic

# The specific AI model to run.
# Examples: claude-3-5-sonnet-latest (anthropic), gpt-4o (openai), gemini-1.5-pro (google)
GOOSE_MODEL=claude-3-5-sonnet-latest

# API Keys (Provide the key corresponding to your selected GOOSE_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# Goose Extensions & MCP Servers
# ------------------------------------------------------------------------------

# Comma-separated list of built-in Goose extension toolkits to load.
# Options include: developer, memory, etc.
# Format: comma-separated list of strings without spaces.
# Example: developer,memory
GOOSE_BUILTIN_EXTENSIONS=developer,memory

# JSON array defining external Model Context Protocol (MCP) servers to register.
# Format: Valid JSON array of objects, containing "name", "command", and optionally "args" and "env".
# Note: Keep the JSON array on a single line.
# Example: [{"name": "sqlite", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db", "/path/to/db.sqlite"]}]
GOOSE_MCP_SERVERS=[]
